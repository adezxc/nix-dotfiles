# internal-ingress: declarative `*.internal.<domain>` reverse-proxy vhosts.
#
# Every entry in `services.internalIngress.services` gets an nginx vhost at
# `<subdomain>.<domain>` that
#
#   1. proxies to a local port (so services that only ever had a bare
#      :8989 / :3001 ... get a real name),
#   2. is reachable *only* from `allowedCidrs` (LAN + tailnet by default) —
#      everyone else gets 403. This is an IP allowlist, deliberately not an
#      auth layer: the apps keep their own logins,
#   3. uses one shared wildcard certificate issued over ACME DNS-01
#      (`acme.enable`) so it works for names that only resolve privately,
#   4. writes its own access log to /var/log/nginx/<name>.log with the real
#      client IP, X-Forwarded-For, upstream address and timings.
#
# The log format is installed once as `log_format ingress` for the whole http
# block, so hand-written public vhosts (e.g. machines/phoenix/media.nix) can
# use `access_log /var/log/nginx/<name>.log ingress;` too. Keep that in sync
# with `accessLogFormat` below.
#
# Example:
#
#   services.internalIngress = {
#     enable = true;
#     domain = "internal.example.com";
#     acme.environmentFile = config.age.secrets.dns-api.path;
#     services = {
#       sonarr = {port = 8989;};
#       grafana = {port = 3001;};
#       # vhost is generated by its own NixOS module (services.freshrss):
#       freshrss = {manageVhost = false;};
#     };
#   };
{
  config,
  lib,
  pkgs,
  ...
}: let
  cfg = config.services.internalIngress;

  inherit
    (lib)
    mkEnableOption
    mkIf
    mkOption
    optional
    optionalAttrs
    types
    ;

  fqdnOf = svc: "${svc.subdomain}.${cfg.domain}";

  accessLogFormat = ''
    log_format ingress '$remote_addr - $remote_user [$time_local] "$host" "$request" '
                       '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                       'xff="$http_x_forwarded_for" rt=$request_time urt=$upstream_response_time';
  '';

  serviceType = types.submodule ({
    name,
    ...
  }: {
    options = {
      enable = mkOption {
        type = types.bool;
        default = true;
        description = "Whether to create a vhost for this service.";
      };

      subdomain = mkOption {
        type = types.str;
        default = name;
        defaultText = lib.literalExpression "the attribute name";
        description = "Left-most label of `<subdomain>.<domain>`.";
      };

      manageVhost = mkOption {
        type = types.bool;
        default = true;
        description = ''
          When false, no locations/proxyPass are generated and only the
          TLS/ACL/logging bits are added to an already existing
          `services.nginx.virtualHosts.<subdomain>.<domain>` — for services
          whose NixOS module builds its own vhost (e.g. `services.freshrss`).
        '';
      };

      port = mkOption {
        type = types.nullOr types.port;
        default = null;
        description = "Local port to proxy to. Required unless `manageVhost = false`.";
      };

      host = mkOption {
        type = types.str;
        default = "127.0.0.1";
        description = "Host the upstream listens on.";
      };

      scheme = mkOption {
        type = types.enum ["http" "https"];
        default = "http";
        description = "Scheme used towards the upstream.";
      };

      websockets = mkOption {
        type = types.bool;
        default = true;
        description = "Pass Upgrade/Connection headers (needed by most web UIs).";
      };

      allowCidrs = mkOption {
        type = types.nullOr (types.listOf types.str);
        default = null;
        description = "Override `services.internalIngress.allowedCidrs` for this one service.";
      };

      clientMaxBodySize = mkOption {
        type = types.nullOr types.str;
        default = null;
        description = "Value for `client_max_body_size` (e.g. \"300M\" for uploads).";
      };

      extraConfig = mkOption {
        type = types.lines;
        default = "";
        description = "Extra lines for the `server` block.";
      };

      locationExtraConfig = mkOption {
        type = types.lines;
        default = "";
        description = "Extra lines for the generated `location /` block.";
      };

      accessLog = mkOption {
        type = types.bool;
        default = true;
        description = "Write a per-service access log to /var/log/nginx/<attrname>.log.";
      };
    };
  });

  mkVhost = name: svc: let
    cidrs =
      if svc.allowCidrs != null
      then svc.allowCidrs
      else cfg.allowedCidrs;
  in
    {
      serverName = fqdnOf svc;

      extraConfig = lib.concatStringsSep "\n" (
        ["# generated by services.internalIngress"]
        ++ (map (cidr: "allow ${cidr};") cidrs)
        ++ ["deny all;"]
        ++ optional svc.accessLog "access_log /var/log/nginx/${name}.log ingress;"
        ++ optional (svc.clientMaxBodySize != null) "client_max_body_size ${svc.clientMaxBodySize};"
        ++ optional (svc.extraConfig != "") svc.extraConfig
      );
    }
    // optionalAttrs cfg.acme.enable {
      useACMEHost = cfg.acme.certName;
      forceSSL = true;
    }
    // optionalAttrs svc.manageVhost {
      locations."/" = {
        proxyPass = "${svc.scheme}://${svc.host}:${toString svc.port}";
        proxyWebsockets = svc.websockets;
        extraConfig = svc.locationExtraConfig;
      };
    };
in {
  options.services.internalIngress = {
    enable = mkEnableOption "internal-only `*.internal.<domain>` nginx vhosts";

    domain = mkOption {
      type = types.str;
      default = "internal.adamjasinski.xyz";
      description = "Parent domain of the generated vhosts.";
    };

    allowedCidrs = mkOption {
      type = types.listOf types.str;
      default = [
        "127.0.0.1"
        "::1"
        "192.168.0.0/24"
        "100.64.0.0/10"
      ];
      description = ''
        Source networks allowed to reach the internal vhosts; everything else
        is answered with 403. Defaults are loopback, the /24 LAN and the
        Tailscale CGNAT range.
      '';
    };

    acme = {
      enable = mkOption {
        type = types.bool;
        default = true;
        description = "Issue one shared wildcard certificate via ACME DNS-01.";
      };

      certName = mkOption {
        type = types.str;
        default = "internal-wildcard";
        description = "Name of the `security.acme.certs.<name>` entry to create/use.";
      };

      dnsProvider = mkOption {
        type = types.str;
        default = "hostinger";
        description = "lego DNS provider (`lego dnshelp` for the full list).";
      };

      environmentFile = mkOption {
        type = types.nullOr types.str;
        default = null;
        description = ''
          File providing the provider's API token (e.g. HOSTINGER_API_TOKEN).
          Normally an agenix secret path.
        '';
      };

      dnsPropagationCheck = mkOption {
        type = types.bool;
        default = true;
        description = "Wait until the TXT record is visible before validating.";
      };

      extraDomainNames = mkOption {
        type = types.listOf types.str;
        default = [];
        description = "Extra SANs for the wildcard certificate.";
      };
    };

    services = mkOption {
      type = types.attrsOf serviceType;
      default = {};
      description = "Services to publish under `*.internal.<domain>`.";
    };
  };

  config = mkIf cfg.enable {
    warnings = optional (cfg.acme.enable && cfg.acme.environmentFile == null) ''
      services.internalIngress.acme.enable is on but
      `services.internalIngress.acme.environmentFile` is null: lego will try to
      talk to the DNS provider without credentials.
    '';

    services.nginx = {
      enable = true;
      recommendedProxySettings = true;
      commonHttpConfig = accessLogFormat;

      virtualHosts =
        lib.mapAttrs' (name: svc: lib.nameValuePair (fqdnOf svc) (mkVhost name svc))
        (lib.filterAttrs (_: svc: svc.enable) cfg.services);
    };

    # nginx runs unprivileged and its pre-start `nginx -t` cannot create new
    # files in /var/log/nginx while the unit is sandboxed
    # (ProtectSystem=strict), so pre-create one access log per vhost. Without
    # this the first switch fails with
    #   open("/var/log/nginx/<name>.log") failed (13: Permission denied)
    systemd.tmpfiles.rules =
      map (name: "f /var/log/nginx/${name}.log 0640 nginx nginx -") (
        lib.attrNames (lib.filterAttrs (_: svc: svc.enable && svc.accessLog) cfg.services)
      );

    security.acme.certs.${cfg.acme.certName} = mkIf cfg.acme.enable {
      domain = "*.${cfg.domain}";
      dnsProvider = cfg.acme.dnsProvider;
      environmentFile = cfg.acme.environmentFile;
      dnsPropagationCheck = cfg.acme.dnsPropagationCheck;
      extraDomainNames = cfg.acme.extraDomainNames;

      # The nginx module only defaults this for `enableACME` vhosts; for a
      # shared `useACMEHost` cert it stays "acme" and nginx cannot read
      # key.pem. `reloadServices = ["nginx.service"]` is added by the nginx
      # module for every vhost with `useACMEHost`, so renewals reload nginx.
      group = "nginx";
    };
  };
}
