# Homepage dashboard: one page listing every service on phoenix, with a
# live up/down dot per tile.
#
# Reached at https://start.internal.adamjasinski.xyz (vhost generated by
# modules/nixos/internal-ingress.nix, so LAN + tailnet only).
#
# Two URLs matter per entry:
#   href  - what the *browser* follows: the public or internal hostname.
#   ping  - what *homepage* probes server-side. Always the loopback port, so
#           status checks don't hairpin through the router and don't depend on
#           DNS. Services without a TCP port (freshrss is php-fpm behind a
#           unix socket) fall back to pinging their hostname over nginx.
{
  lib,
  ...
}: let
  # mk { name, href, port } -> { "<name>" = { ... }; }
  mk = {
    name,
    href,
    port ? null,
    icon ? null,
    description ? null,
    ping ? (
      if port != null
      then "http://127.0.0.1:${toString port}"
      else href
    ),
  }: {
    "${name}" =
      {
        inherit href ping;
      }
      // lib.optionalAttrs (icon != null) {inherit icon;}
      // lib.optionalAttrs (description != null) {inherit description;};
  };

  # Service groups. `internal` = <name>.internal.adamjasinski.xyz.
  public = [
    (mk {
      name = "Jellyfin";
      href = "https://jellyfin.adamjasinski.xyz";
      port = 8096;
      icon = "jellyfin.png";
      description = "Movies & TV";
    })
    (mk {
      name = "Navidrome";
      href = "https://music.adamjasinski.xyz";
      port = 4533;
      icon = "navidrome.png";
      description = "Music";
    })
    (mk {
      name = "Seerr";
      href = "https://seerr.adamjasinski.xyz";
      port = 5055;
      icon = "jellyseerr.png";
      description = "Requests";
    })
    (mk {
      name = "Immich";
      href = "https://immich.adamjasinski.xyz";
      port = 3002;
      icon = "immich.png";
      description = "Photos";
    })
    (mk {
      name = "Vaultwarden";
      href = "https://vaultwarden.adamjasinski.xyz";
      port = 8222;
      icon = "vaultwarden.png";
      description = "Passwords";
    })
  ];

  media = [
    (mk {
      name = "Sonarr";
      href = "https://sonarr.internal.adamjasinski.xyz";
      port = 8989;
      icon = "sonarr.png";
      description = "TV";
    })
    (mk {
      name = "Radarr";
      href = "https://radarr.internal.adamjasinski.xyz";
      port = 7878;
      icon = "radarr.png";
      description = "Movies";
    })
    (mk {
      name = "Lidarr";
      href = "https://lidarr.internal.adamjasinski.xyz";
      port = 8686;
      icon = "lidarr.png";
      description = "Music";
    })
    (mk {
      name = "Prowlarr";
      href = "https://prowlarr.internal.adamjasinski.xyz";
      port = 9696;
      icon = "prowlarr.png";
      description = "Indexers";
    })
    (mk {
      name = "Bazarr";
      href = "https://bazarr.internal.adamjasinski.xyz";
      port = 6767;
      icon = "bazarr.png";
      description = "Subtitles";
    })
    (mk {
      name = "Audiobookshelf";
      href = "https://audiobooks.internal.adamjasinski.xyz";
      port = 9292;
      icon = "audiobookshelf.png";
      description = "Audiobooks";
    })
    (mk {
      name = "Calibre-Web";
      href = "https://calibre.internal.adamjasinski.xyz";
      port = 8083;
      icon = "calibre-web.png";
      description = "Ebooks";
    })
    (mk {
      name = "FreshRSS";
      href = "https://freshrss.internal.adamjasinski.xyz";
      icon = "freshrss.png";
      description = "Feeds";
    })
  ];

  downloads = [
    (mk {
      name = "SABnzbd";
      href = "https://sabnzbd.internal.adamjasinski.xyz";
      port = 9999;
      icon = "sabnzbd.png";
      description = "Usenet";
    })
    (mk {
      name = "Transmission";
      href = "https://transmission.internal.adamjasinski.xyz";
      port = 9091;
      icon = "transmission.png";
      description = "Torrents";
    })
    (mk {
      name = "slskd";
      href = "https://slskd.internal.adamjasinski.xyz";
      port = 5030;
      icon = "slskd.png";
      description = "Soulseek";
    })
  ];

  infra = [
    (mk {
      name = "Home Assistant";
      href = "https://home.internal.adamjasinski.xyz";
      port = 8123;
      icon = "home-assistant.png";
      description = "Automation";
    })
    (mk {
      name = "Grafana";
      href = "https://grafana.internal.adamjasinski.xyz";
      port = 3001;
      icon = "grafana.png";
      description = "Dashboards";
    })
    (mk {
      name = "Prometheus";
      href = "https://prometheus.internal.adamjasinski.xyz";
      port = 9090;
      icon = "prometheus.png";
      description = "Metrics";
    })
  ];
in {
  services.homepage-dashboard = {
    enable = true;
    listenPort = 8082;

    # Homepage refuses requests whose Host header isn't listed here.
    allowedHosts = "start.internal.adamjasinski.xyz,localhost:8082,127.0.0.1:8082";

    settings = {
      title = "phoenix";
      theme = "dark";
      color = "slate";
      headerStyle = "boxed";
      statusStyle = "dot";
      hideVersion = true;
      layout = {
        "Public" = {
          style = "row";
          columns = 5;
        };
        "Media" = {
          style = "row";
          columns = 4;
        };
        "Downloads" = {
          style = "row";
          columns = 4;
        };
        "Infrastructure" = {
          style = "row";
          columns = 3;
        };
      };
    };

    widgets = [
      {
        resources = {
          cpu = true;
          memory = true;
          disk = "/";
        };
      }
      {
        search = {
          provider = "duckduckgo";
          target = "_blank";
        };
      }
      {
        datetime = {
          text_size = "xl";
          format = {
            dateStyle = "long";
            timeStyle = "short";
          };
        };
      }
      {
        openmeteo = {
          label = "Vilnius";
          latitude = 54.71;
          longitude = 25.23;
          timezone = "Europe/Vilnius";
          units = "metric";
          cache = 5;
        };
      }
    ];

    services = [
      {"Public" = public;}
      {"Media" = media;}
      {"Downloads" = downloads;}
      {"Infrastructure" = infra;}
    ];
  };
}
